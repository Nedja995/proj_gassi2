# Force LF line endings for all text files in this repository.
# Prevents CRLF/LF mismatch across platforms and tooling.

* text=auto eol=lf

# Explicitly LF
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.sh    text eol=lf

# Binary — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.exe   binary
*.dll   binary
*.pyd   binary
*.so    binary
